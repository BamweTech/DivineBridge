# Environment
FLASK_ENV=development

# Mobile local iOS: Personal Team cannot sign Push. Omit, or set IOS_PUSH=1
# once the organization team is used (EAS sets this path automatically).
# IOS_PUSH=

# Email Configuration
EMAIL_SERVICE_ACCOUNT={"type": "service_account", ...}
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Google Cloud Configuration
PRAYER_SERVICE_ACCOUNT={"type": "service_account", ...}
SHEET_ID=your-sheet-id

# API Keys
PERPLEXITY_API_KEY=your-api-key

# Google Sheets Configuration
GOOGLE_CREDENTIALS_FILE=credentials.json
SPREADSHEET_ID=your_spreadsheet_id

# Firebase Configuration
FIREBASE_CREDENTIALS={"type": "service_account", ...}

# Flask Configuration
FLASK_APP=app.py

# Prayer room / WebRTC — SFU WebSocket URLs (optional regional overrides)
# Omit in production to use defaults (sfu.divinebridge.io / sfu-eu / sfu-ap).
# Local SFU: SFU_URL=ws://127.0.0.1:3000/ws
# SFU_URL=
# SFU_URL_US=wss://sfu.divinebridge.io/ws
# SFU_URL_EU=wss://sfu-eu.divinebridge.io/ws
# SFU_URL_AP=wss://sfu-ap.divinebridge.io/ws
# SFU_REGIONS_ENABLED=us,eu          # add ap when AP VM is deployed