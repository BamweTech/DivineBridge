# Copy to scripts/deploy.env (optional). That file is gitignored.
# deploy.sh sources scripts/deploy.env automatically if it exists.
# Or export these variables in your shell before running ./scripts/deploy.sh

# Google Cloud (Cloud Run + Cloud Build)
export GCP_PROJECT="${GCP_PROJECT:-divinebridge}"
# Must match the region where the Cloud Run service was created
export GCP_REGION="${GCP_REGION:-us-central1}"
export CLOUD_RUN_SERVICE="${CLOUD_RUN_SERVICE:-divinebridge}"
export CLOUD_RUN_PORT="${CLOUD_RUN_PORT:-8080}"

# Container image for --cloud-run-method=image (GCR)
export CONTAINER_IMAGE="${CONTAINER_IMAGE:-gcr.io/divinebridge/divinebridge}"

# Firebase / Firestore (same project id as GCP when linked)
export FIREBASE_PROJECT="${FIREBASE_PROJECT:-divinebridge}"
