rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isPrayerGroupMember(groupId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/prayer_groups/$(groupId))
        && request.auth.uid in get(/databases/$(database)/documents/prayer_groups/$(groupId)).data.member_ids;
    }

    // Users collection - users can only access their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Prayer rooms collection - enhanced security with room membership validation
    match /prayer_rooms/{roomId} {
      // Allow read for authenticated users
      allow read: if request.auth != null;
      
      // Allow create only for authenticated users with proper data structure
      allow create: if request.auth != null && 
                  request.resource.data.host_id == request.auth.uid &&
                  request.resource.data.keys().hasAll(['room_name', 'host_id', 'host_name', 'created_at', 'room_privacy']) &&
                  request.resource.data.room_name is string &&
                  request.resource.data.room_name.size() <= 100 &&
                  request.resource.data.room_privacy in ['public', 'private'] &&
                  request.resource.data.host_name is string &&
                  request.resource.data.host_name.size() <= 50;
      
      // Allow update/delete only by room host
      allow update, delete: if request.auth != null && 
                          resource.data.host_id == request.auth.uid;
      
      // Subcollections for prayer rooms
      match /chat_messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && 
                    request.resource.data.user_id == request.auth.uid &&
                    request.resource.data.keys().hasAll(['user_id', 'user_name', 'message', 'timestamp', 'room_id']) &&
                    request.resource.data.message is string &&
                    request.resource.data.message.size() <= 1000 &&
                    request.resource.data.user_name is string &&
                    request.resource.data.user_name.size() <= 50;
        allow update, delete: if request.auth != null && 
                            resource.data.user_id == request.auth.uid;
      }
      
      match /webrtc_offers/{offerId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && 
                    request.resource.data.from_user == request.auth.uid &&
                    request.resource.data.keys().hasAll(['from_user', 'to_user', 'offer', 'timestamp']) &&
                    request.resource.data.offer is map &&
                    request.resource.data.offer.keys().hasAll(['type', 'sdp']) &&
                    request.resource.data.offer.type in ['offer'] &&
                    request.resource.data.offer.sdp is string &&
                    request.resource.data.offer.sdp.size() <= 10000;
        allow delete: if request.auth != null && 
                    resource.data.from_user == request.auth.uid;
      }
      
      match /webrtc_answers/{answerId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && 
                    request.resource.data.from_user == request.auth.uid &&
                    request.resource.data.keys().hasAll(['from_user', 'to_user', 'answer', 'timestamp']) &&
                    request.resource.data.answer is map &&
                    request.resource.data.answer.keys().hasAll(['type', 'sdp']) &&
                    request.resource.data.answer.type in ['answer'] &&
                    request.resource.data.answer.sdp is string &&
                    request.resource.data.answer.sdp.size() <= 10000;
        allow delete: if request.auth != null && 
                    resource.data.from_user == request.auth.uid;
      }
      
      match /device_sessions/{sessionId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && 
                    request.resource.data.user_id == request.auth.uid &&
                    request.resource.data.keys().hasAll(['user_id', 'device_id', 'device_info', 'is_active', 'created_at', 'last_seen']) &&
                    request.resource.data.device_id is string &&
                    request.resource.data.device_id.size() <= 100 &&
                    request.resource.data.device_info is map &&
                    request.resource.data.device_info.keys().hasAll(['user_agent', 'platform', 'language']) &&
                    request.resource.data.is_active is bool;
        allow update, delete: if request.auth != null && 
                            resource.data.user_id == request.auth.uid;
      }
      
      match /speaking_states/{stateId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && 
                    request.resource.data.user_id == request.auth.uid &&
                    request.resource.data.keys().hasAll(['user_id', 'is_speaking', 'timestamp']) &&
                    request.resource.data.is_speaking is bool;
        allow update, delete: if request.auth != null && 
                            resource.data.user_id == request.auth.uid;
      }
      
      match /participants/{participantId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && 
                    request.resource.data.user_id == request.auth.uid &&
                    request.resource.data.keys().hasAll(['user_id', 'user_name', 'joined_at', 'is_active']) &&
                    request.resource.data.user_name is string &&
                    request.resource.data.user_name.size() <= 50 &&
                    request.resource.data.is_active is bool;
        allow update, delete: if request.auth != null && 
                            resource.data.user_id == request.auth.uid;
      }
    }
    
    // Scheduled rooms collection - enhanced validation
    match /scheduled_rooms/{scheduledRoomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
                  request.resource.data.host_id == request.auth.uid &&
                  request.resource.data.keys().hasAll(['room_name', 'host_id', 'host_name', 'scheduled_time', 'room_privacy']) &&
                  request.resource.data.room_name is string &&
                  request.resource.data.room_name.size() <= 100 &&
                  request.resource.data.room_privacy in ['public', 'private'] &&
                  request.resource.data.host_name is string &&
                  request.resource.data.host_name.size() <= 50 &&
                  request.resource.data.scheduled_time is timestamp &&
                  request.resource.data.scheduled_time > request.time;
      allow update, delete: if request.auth != null && 
                          resource.data.host_id == request.auth.uid;
    }
    
    // Chat messages collection (legacy - for backward compatibility)
    match /chat_messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
                  request.resource.data.user_id == request.auth.uid &&
                  request.resource.data.keys().hasAll(['user_id', 'user_name', 'message', 'timestamp', 'room_id']) &&
                  request.resource.data.message is string &&
                  request.resource.data.message.size() <= 1000 &&
                  request.resource.data.user_name is string &&
                  request.resource.data.user_name.size() <= 50;
      allow update, delete: if request.auth != null && 
                          resource.data.user_id == request.auth.uid;
    }
    
    // WebRTC signaling collections (legacy - for backward compatibility)
    match /webrtc_offers/{offerId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
                  request.resource.data.from_user == request.auth.uid &&
                  request.resource.data.keys().hasAll(['from_user', 'to_user', 'offer', 'timestamp']) &&
                  request.resource.data.offer is map &&
                  request.resource.data.offer.keys().hasAll(['type', 'sdp']) &&
                  request.resource.data.offer.type in ['offer'] &&
                  request.resource.data.offer.sdp is string &&
                  request.resource.data.offer.sdp.size() <= 10000;
      allow delete: if request.auth != null && 
                  resource.data.from_user == request.auth.uid;
    }
    
    match /webrtc_answers/{answerId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
                  request.resource.data.from_user == request.auth.uid &&
                  request.resource.data.keys().hasAll(['from_user', 'to_user', 'answer', 'timestamp']) &&
                  request.resource.data.answer is map &&
                  request.resource.data.answer.keys().hasAll(['type', 'sdp']) &&
                  request.resource.data.answer.type in ['answer'] &&
                  request.resource.data.answer.sdp is string &&
                  request.resource.data.answer.sdp.size() <= 10000;
      allow delete: if request.auth != null && 
                  resource.data.from_user == request.auth.uid;
    }
    
    // Device sessions collection (legacy - for backward compatibility)
    match /device_sessions/{sessionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
                  request.resource.data.user_id == request.auth.uid &&
                  request.resource.data.keys().hasAll(['user_id', 'device_id', 'device_info', 'is_active', 'created_at', 'last_seen']) &&
                  request.resource.data.device_id is string &&
                  request.resource.data.device_id.size() <= 100 &&
                  request.resource.data.device_info is map &&
                  request.resource.data.device_info.keys().hasAll(['user_agent', 'platform', 'language']) &&
                  request.resource.data.is_active is bool;
      allow update, delete: if request.auth != null && 
                          resource.data.user_id == request.auth.uid;
    }
    
    // Speaking state collection (legacy - for backward compatibility)
    match /speaking_states/{stateId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
                  request.resource.data.user_id == request.auth.uid &&
                  request.resource.data.keys().hasAll(['user_id', 'is_speaking', 'timestamp']) &&
                  request.resource.data.is_speaking is bool;
      allow update, delete: if request.auth != null && 
                          resource.data.user_id == request.auth.uid;
    }
    
    // Testimonies collection - public read, authenticated write
    match /testimonies/{testimonyId} {
      allow read: if true;
      allow write: if request.auth != null &&
                  request.resource.data.keys().hasAll(['user_id', 'testimony', 'timestamp', 'status']) &&
                  request.resource.data.user_id == request.auth.uid &&
                  request.resource.data.testimony is string &&
                  request.resource.data.testimony.size() <= 2000 &&
                  request.resource.data.status in ['pending', 'approved', 'rejected'];
    }
    
    // Prayers collection - public read, authenticated write
    match /prayers/{prayerId} {
      allow read: if true;
      allow write: if request.auth != null &&
                  request.resource.data.keys().hasAll(['user_id', 'prayer', 'timestamp']) &&
                  request.resource.data.user_id == request.auth.uid &&
                  request.resource.data.prayer is string &&
                  request.resource.data.prayer.size() <= 5000;
    }
    
    // User prayed prayers - users can only access their own data
    match /user_prayed_prayers/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Prayer requests - public read, authenticated write
    match /prayer_requests/{requestId} {
      allow read: if true;
      allow write: if request.auth != null &&
                  request.resource.data.keys().hasAll(['user_id', 'request', 'timestamp', 'status']) &&
                  request.resource.data.user_id == request.auth.uid &&
                  request.resource.data.request is string &&
                  request.resource.data.request.size() <= 1000 &&
                  request.resource.data.status in ['pending', 'fulfilled', 'closed'];
    }
    
    // User interactions - users can only access their own data
    match /user_interactions/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Daily prayers collection - public read, authenticated interactions
    match /daily_prayers/{date} {
      allow read: if true;
      
      // Likes subcollection
      match /likes/{likeId} {
        allow read: if true;
        allow create: if request.auth != null &&
                    request.resource.data.user_id == request.auth.uid &&
                    request.resource.data.keys().hasAll(['user_id', 'user_name', 'created_at']) &&
                    request.resource.data.user_id == request.auth.uid;
        allow delete: if request.auth != null &&
                    resource.data.user_id == request.auth.uid;
      }
      
      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null &&
                    request.resource.data.user_id == request.auth.uid &&
                    request.resource.data.keys().hasAll(['user_id', 'user_name', 'comment', 'created_at']) &&
                    request.resource.data.comment is string &&
                    request.resource.data.comment.size() <= 500 &&
                    request.resource.data.user_name is string &&
                    request.resource.data.user_name.size() <= 50;
        allow update, delete: if request.auth != null &&
                            resource.data.user_id == request.auth.uid;
      }
      
      // Shares subcollection
      match /shares/{shareId} {
        allow read: if true;
        allow create: if request.auth != null &&
                    request.resource.data.user_id == request.auth.uid &&
                    request.resource.data.keys().hasAll(['user_id', 'user_name', 'platform', 'created_at']) &&
                    request.resource.data.platform is string &&
                    request.resource.data.platform.size() <= 50;
      }
    }
    
    // Daily verses collection - public read, authenticated interactions
    match /daily_verses/{date} {
      allow read: if true;
      
      // Likes subcollection
      match /likes/{likeId} {
        allow read: if true;
        allow create: if request.auth != null &&
                    request.resource.data.user_id == request.auth.uid &&
                    request.resource.data.keys().hasAll(['user_id', 'user_name', 'created_at']) &&
                    request.resource.data.user_id == request.auth.uid;
        allow delete: if request.auth != null &&
                    resource.data.user_id == request.auth.uid;
      }
      
      // Shares subcollection
      match /shares/{shareId} {
        allow read: if true;
        allow create: if request.auth != null &&
                    request.resource.data.user_id == request.auth.uid &&
                    request.resource.data.keys().hasAll(['user_id', 'user_name', 'platform', 'created_at']) &&
                    request.resource.data.platform is string &&
                    request.resource.data.platform.size() <= 50;
      }
    }
    
    // ─── WebRTC Firestore Signaling (mobile app — replaces HTTP polling) ────────
    match /prayer_rooms/{roomId}/signaling/{sigId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
                  request.resource.data.from_user == request.auth.uid &&
                  request.resource.data.type in ['offer', 'answer', 'candidate'] &&
                  request.resource.data.keys().hasAll(['type', 'from_user', 'to_user', 'timestamp']);
      allow delete: if request.auth != null &&
                  resource.data.from_user == request.auth.uid;
    }

    // ─── Prayer Groups ────────────────────────────────────────────────────────
    match /prayer_groups/{groupId} {
      // Public groups readable by anyone; private/invite_only by members only
      allow read: if resource.data.privacy == 'public' ||
                  (request.auth != null && request.auth.uid in resource.data.member_ids);
      // Creation and updates handled by backend Flask routes only (no direct client writes)
      allow create, update, delete: if false;
    }

    match /group_members/{groupId}/members/{memberId} {
      allow read: if isPrayerGroupMember(groupId);
      // Writes handled by Flask backend
      allow write: if false;
    }

    function groupChatAttachmentItem(m) {
      return m is map
        && m.keys().hasAll(['url', 'content_type', 'file_name'])
        && m.url is string
        && m.url.size() <= 2048
        && m.url.matches('https://firebasestorage.googleapis.com/.*')
        && m.content_type is string
        && m.content_type.size() <= 120
        && m.file_name is string
        && m.file_name.size() <= 200;
    }

    function validGroupChatAttachments(att) {
      return att is list
        && att.size() >= 1
        && att.size() <= 3
        && groupChatAttachmentItem(att[0])
        && (att.size() < 2 || groupChatAttachmentItem(att[1]))
        && (att.size() < 3 || groupChatAttachmentItem(att[2]));
    }

    function groupChatHasBody() {
      return request.resource.data.message is string
        && request.resource.data.message.size() <= 2000
        && (
          request.resource.data.message.size() > 0
          || (
            request.resource.data.keys().hasAny(['link_url'])
            && request.resource.data.link_url is string
            && request.resource.data.link_url.size() > 0
            && request.resource.data.link_url.size() <= 2048
            && request.resource.data.link_url.matches('https://.*')
          )
          || (
            request.resource.data.keys().hasAny(['attachments'])
            && validGroupChatAttachments(request.resource.data.attachments)
          )
        );
    }

    function linkUrlFieldValid() {
      return !request.resource.data.keys().hasAny(['link_url'])
        || (
          request.resource.data.link_url is string
          && request.resource.data.link_url.size() <= 2048
          && request.resource.data.link_url.matches('https://.*')
        );
    }

    function attachmentsFieldValid() {
      return !request.resource.data.keys().hasAny(['attachments'])
        || validGroupChatAttachments(request.resource.data.attachments);
    }

    function groupChatReactionUpdateValid() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        && (
          !request.resource.data.keys().hasAny(['reactions'])
          || request.resource.data.reactions is map
        );
    }

    // ─── Group Chat Messages ──────────────────────────────────────────────────
    match /group_chat_messages/{groupId}/messages/{messageId} {
      allow read: if isPrayerGroupMember(groupId);
      // Direct client writes (members only). Text, optional https link, optional Storage attachments.
      allow create: if isPrayerGroupMember(groupId) &&
                  request.resource.data.user_id == request.auth.uid &&
                  request.resource.data.keys().hasAll(['user_id', 'user_name', 'message', 'message_type', 'timestamp']) &&
                  groupChatHasBody() &&
                  linkUrlFieldValid() &&
                  attachmentsFieldValid();
      allow update: if isPrayerGroupMember(groupId) &&
                  (
                    resource.data.user_id == request.auth.uid
                    || groupChatReactionUpdateValid()
                  );
      allow delete: if isPrayerGroupMember(groupId) &&
                  resource.data.user_id == request.auth.uid;
    }

    // ─── Devotional Plans ─────────────────────────────────────────────────────
    match /devotional_plans/{planId} {
      // Only the plan owner can read or write
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      // Generates created by backend; check-ins update allowed directly from mobile
      allow update: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create, delete: if false;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
