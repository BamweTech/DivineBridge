# Copy to .env and fill in values

# ── Firebase (for ID token verification — no shared secret needed) ───────────
# Credentials are loaded automatically from the "FIREBASE_CREDENTIALS" GCP Secret
# (same secret Flask uses). No key file or shared secret to manage.
#
# On GCP (Cloud Run / GKE): nothing to set — workload identity handles it.
# Locally: run `gcloud auth application-default login` once and that's it.
FIREBASE_PROJECT_ID=divinebridge

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# Public IP for ICE candidates.  On GCE, leave as 127.0.0.1 — the server
# auto-detects the external IP from the metadata API at startup.
# Set explicitly only if auto-detection doesn't apply (e.g. AWS, bare metal).
ANNOUNCED_IP=127.0.0.1

# ── mediasoup ────────────────────────────────────────────────────────────────
NUM_WORKERS=           # defaults to os.cpus().length

# RTC port range (open these in your firewall)
RTC_MIN_PORT=10000
RTC_MAX_PORT=10999
